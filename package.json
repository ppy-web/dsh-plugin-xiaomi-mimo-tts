{
  "name": "dsh-xiaomi-tts",
  "version": "4.3.0-alpha.1",
  "description": "为 DSH 添加 Xiaomi MiMo 与豆包语音朗读、浏览器本地语音兜底和可选 UI 音效。",
  "icon": "./assets/plugin-icons/avatar.webp",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "xiaomi",
    "mimo",
    "tts",
    "text-to-speech"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppy-web/dsh-plugin-xiaomi-mimo-tts.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./client-api": {
      "types": "./lib/client-api.d.ts",
      "default": "./lib/client-api.js"
    },
    "./host-api": {
      "types": "./lib/host-api.d.ts",
      "default": "./lib/host-api.js"
    },
    "./host": {
      "types": "./lib/speech-host.d.ts",
      "default": "./lib/speech-host.js"
    },
    "./speech-agent": {
      "types": "./lib/speech-agent.d.ts",
      "default": "./lib/speech-agent.js"
    },
    "./qqbot": {
      "types": "./lib/qqbot.d.ts",
      "default": "./lib/qqbot.js"
    },
    "./qqbot/icon": "./assets/plugin-icons/qqbot.webp",
    "./qqbot-agent": {
      "types": "./lib/qqbot-agent.d.ts",
      "default": "./lib/qqbot-agent.js"
    },
    "./qqbot/locale/*.json": "./locale/qqbot/*.json",
    "./whale-girl": {
      "types": "./lib/whale-girl.d.ts",
      "default": "./lib/whale-girl.js"
    },
    "./whale-girl/icon": "./assets/plugin-icons/preset.webp",
    "./whale-girl/locale/*.json": "./locale/whale-girl/*.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client.js.map",
    "locale",
    "tools/scripts/prepare-package.mjs",
    "cordis.patch.yml",
    "README.md",
    "handbook.md",
    "intro.md",
    "skills",
    "assets",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.6-alpha.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@shikijs/langs": "^4.3.1",
    "@types/node": "^26.6.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "immer": "11.1.18",
    "js-yaml": "4.3.1",
    "katex": "^0.18.7",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.3.1",
    "simple-icons": "16.33.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.8.0",
    "vite": "8.3.0",
    "zustand": "~4.4.7"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "motion": "^14.1.0",
    "react-icons": "^5.7.0",
    "silk-wasm": "3.7.1",
    "ws": "8.21.3"
  },
  "scripts": {
    "dev": "vite --config tools/preview/vite.config.ts",
    "dev:build": "tsc -p tools/preview/tsconfig.json && vite build --config tools/preview/vite.config.ts",
    "build": "tsdown -c tsdown.config.ts && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "profile:check": "node tools/scripts/dsh-profile-verify.mjs",
    "release:check": "pnpm run test",
    "prepare": "node tools/scripts/prepare-package.mjs",
    "prepack": "pnpm run build && node tools/scripts/pack-package.mjs",
    "postpack": "node tools/scripts/restore-package-scripts.mjs",
    "pack:check": "node tools/scripts/pack-check.mjs"
  }
}
