{
  "name": "dsh-xiaomi-tts",
  "version": "5.2.1",
  "description": "小米MIMO、豆包语音、BreezeBlue、浏览器语音 - 音色随心配，支持连接10＋供应商或本地语音模型，文本过滤、实时流式朗读、音频下载、音效、桌宠联动及 QQ Bot、AI Passport 联动",
  "icon": "./assets/plugin-icons/avatar.webp",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "xiaomi",
    "mimo",
    "doubao",
    "breeze",
    "tts",
    "text-to-speech"
  ],
  "homepage": "https://ppy-web.github.io/dsh-plugin-xiaomi-mimo-tts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppy-web/dsh-plugin-xiaomi-mimo-tts.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./client-api": {
      "types": "./lib/client-api.d.ts",
      "default": "./lib/client-api.js"
    },
    "./host-api": {
      "types": "./lib/host-api.d.ts",
      "default": "./lib/host-api.js"
    },
    "./host": {
      "types": "./lib/speech-host.d.ts",
      "default": "./lib/speech-host.js"
    },
    "./speech-agent": {
      "types": "./lib/speech-agent.d.ts",
      "default": "./lib/speech-agent.js"
    },
    "./qqbot": {
      "types": "./lib/qqbot.d.ts",
      "default": "./lib/qqbot.js"
    },
    "./passport": {
      "types": "./lib/passport.d.ts",
      "default": "./lib/passport.js"
    },
    "./passport/icon": "./assets/plugin-icons/passport.webp",
    "./passport/locale/*.json": "./locale/passport/*.json",
    "./qqbot/icon": "./assets/plugin-icons/qqbot.webp",
    "./qqbot-agent": {
      "types": "./lib/qqbot-agent.d.ts",
      "default": "./lib/qqbot-agent.js"
    },
    "./qqbot/locale/*.json": "./locale/qqbot/*.json",
    "./whale-agent": {
      "types": "./lib/whale-agent.d.ts",
      "default": "./lib/whale-agent.js"
    },
    "./whale-girl": {
      "types": "./lib/whale-girl.d.ts",
      "default": "./lib/whale-girl.js"
    },
    "./whale-girl/icon": "./assets/plugin-icons/preset.webp",
    "./whale-girl/locale/*.json": "./locale/whale-girl/*.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/index.d.ts",
    "lib/client/index.d.ts",
    "lib/client-api.d.ts",
    "lib/host-api.d.ts",
    "lib/host/provider-error.d.ts",
    "lib/speech-host.d.ts",
    "lib/speech-agent.d.ts",
    "lib/qqbot.d.ts",
    "lib/passport.d.ts",
    "lib/passport/*.d.ts",
    "lib/qqbot-agent.d.ts",
    "lib/whale-girl.d.ts",
    "lib/whale-agent.d.ts",
    "lib/host/whale-*.d.ts",
    "lib/types",
    "lib/host/qqbot-*.d.ts",
    "!lib/**/*.map",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "open-api.md",
    "intro.md",
    "skills",
    "!skills/whale-girl/memory",
    "assets",
    "!assets/setting.png",
    "!assets/image.webp",
    "!assets/whale-girl-front.png",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
