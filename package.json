  "scripts": {
    "dev": "vite --config tools/preview/vite.config.ts",
    "dev:build": "tsc -p tools/preview/tsconfig.json && vite build --config tools/preview/vite.config.ts",
    "build": "tsdown -c tsdown.config.ts && tsc --emitDeclarationOnly",
    "build:analyze": "node tools/scripts/analyze-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "profile:check": "node tools/scripts/dsh-profile-verify.mjs",
    "release:check": "pnpm run test",
    "prepare": "node tools/scripts/prepare-package.mjs",
    "prepack": "pnpm run build && node tools/scripts/pack-package.mjs",
    "postpack": "node tools/scripts/restore-package-scripts.mjs",
    "pack:check": "node tools/scripts/pack-check.mjs"
  }
